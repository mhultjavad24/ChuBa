<?xml version="1.0" encoding="UTF-8"?>
<job id="ratings-batch-job"
     xmlns="https://jakarta.ee/xml/ns/jakartaee"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/jobXML_2_0.xsd"
     version="2.0">
    <properties>
        <property name="inputUrl" value="#{jobParameters['inputUrl']}"/>
        <property name="outputPath" value="#{jobParameters['outputPath']}"/>
        <property name="apiBaseUrl" value="#{jobParameters['apiBaseUrl']}"/>
    </properties>

    <step id="enrichRatingsStep">
        <chunk item-count="5">
            <reader ref="ratingItemReader">
                <properties>
                    <property name="inputUrl" value="#{jobParameters['inputUrl']}"/>
                </properties>
            </reader>
            <processor ref="ratingItemProcessor">
                <properties>
                    <property name="apiBaseUrl" value="#{jobParameters['apiBaseUrl']}"/>
                </properties>
            </processor>
            <writer ref="ratingItemWriter">
                <properties>
                    <property name="outputPath" value="#{jobParameters['outputPath']}"/>
                </properties>
            </writer>
        </chunk>
    </step>
</job>
